{
  "$id": "https://workiq.dev/schemas/workiq-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work IQ Bundle Manifest",
  "description": "Manifest for a Work IQ Open Format bundle stored as workiq.yaml.",
  "type": "object",
  "required": [
    "id",
    "version",
    "license",
    "maintainers",
    "conformance_profile",
    "schemas",
    "default_language",
    "sensitivity_model",
    "validation_rules"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "contact"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "contact": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "conformance_profile": {
      "type": "string",
      "enum": ["Core Bundle", "Agent Profile", "Semantic Export"]
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "default_language": {
      "type": "string"
    },
    "sensitivity_model": {
      "type": "string"
    },
    "validation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["format", "path"],
        "properties": {
          "format": { "type": "string" },
          "path": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
