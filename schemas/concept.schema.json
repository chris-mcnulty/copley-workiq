{
  "$id": "https://workiq.dev/schemas/concept.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work IQ Concept Frontmatter",
  "description": "Core frontmatter required for a Work IQ Open Format concept document.",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "description",
    "status",
    "owner",
    "sources",
    "last_verified",
    "stale_after",
    "tags",
    "relationships"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "stable", "deprecated", "archived", "current"]
    },
    "version": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "resource", "author", "last_modified"],
        "properties": {
          "id": { "type": "string" },
          "resource": { "type": "string" },
          "author": { "type": "string" },
          "last_modified": { "type": "string", "format": "date" }
        },
        "additionalProperties": true
      }
    },
    "generated": {
      "type": "object",
      "required": ["by", "at"],
      "properties": {
        "by": { "type": "string" },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["by", "at"],
        "properties": {
          "by": { "type": "string" },
          "at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": true
      }
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "stale_after": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "array",
            "items": {
              "type": ["string", "number", "boolean", "object"]
            }
          },
          { "type": "object" }
        ]
      }
    },
    "access_rights": {
      "type": "string"
    },
    "attestation": {
      "type": "object",
      "properties": {
        "reviewer": { "type": "string" },
        "approved_at": { "type": "string", "format": "date-time" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "decision_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "by": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "canonical_summary": {
      "type": "string"
    },
    "synonyms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_concepts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "chunking_strategy": {
      "type": "string"
    },
    "embedding_scope": {
      "type": "string"
    },
    "exclusion_rules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evaluation_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
